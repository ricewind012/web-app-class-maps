{
	"compilerOptions": {
		"declaration": true,
		"lib": ["esnext"],
		"module": "nodenext",
		"moduleDetection": "force",
		"moduleResolution": "nodenext",
		"outDir": "./dist",
		"rootDir": "./src",
		"skipLibCheck": true,
		"strictNullChecks": false,
		"types": ["node"]
	},
	"include": ["./src"]
}
