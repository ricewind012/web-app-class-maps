#!/usr/bin/env bun

import { readFile } from "node:fs/promises";
import { type Page, readScript } from "@web-app-class-maps/scripts";

const PAGES: Page[] = [
	"steamaccountpreferences",
	"steamapppage",
	"steamclient",
	"steamnotificationspage",
	"steamprofileedit",
	"steamshoppingcart",
	"steamstoremenu",
];

/**
 * Temp fix while `build-class-modules` is still unreliable.
 */
async function isMapEmpty(page: Page) {
	const content = JSON.parse(await readFile(`${page}.json`, "utf8"));
	return Object.keys(content).length === 0;
}

const script = await readScript("build-class-modules");
for (const page of PAGES) {
	await script.execute(page);
	while (await isMapEmpty(page)) {
		await script.execute(page);
	}
}
